{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 600,
    "height": 330,

    "data": {
        "url": "data/attendance_change.csv"
    },

    "transform": [
        {
            "calculate": "datum.group + ': ' + datum.art",
            "as": "row_name"
        },
        {
            "calculate": "round((datum.percentage_202122 - datum.percentage_201718) / datum.percentage_201718 * 100)",
            "as": "change"
        },
        {
            "calculate": "(datum.change > 0 ? '+' : '') + datum.change + '%'",
            "as": "change_label"
        }
    ],

    "encoding": {
        "y": {
            "field": "row_name",
            "type": "nominal",
            "title": null,
            "sort": null
        }
    },

    "layer": [
        {
            "mark": {
                "type": "rule",
                "color": "lightgray",
                "strokeWidth": 3
            },
            "encoding": {
                "x": {
                    "field": "percentage_201718",
                    "type": "quantitative",
                    "title": "% who went in the year",
                    "scale": { "domain": [0, 45] }
                },
                "x2": {
                    "field": "percentage_202122"
                }
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 150,
                "opacity": 1
            },
            "encoding": {
                "x": {
                    "field": "percentage_201718",
                    "type": "quantitative"
                },
                "color": {
                    "datum": "2017-18",
                    "type": "nominal",
                    "scale": {
                        "domain": ["2017-18", "2021-22"],
                        "range": ["#143d51", "#691c2d"]
                    },
                    "legend": {"title": null}
                },
                "tooltip": [
                    { "field": "row_name", "type": "nominal", "title": "Group" },
                    { "field": "percentage_201718", "type": "quantitative", "title": "2017-18 (%)", "format": ".1f" },
                    { "field": "percentage_202122", "type": "quantitative", "title": "2021-22 (%)", "format": ".1f" },
                    { "field": "change_label", "type": "nominal", "title": "Percentage change"}
                ]
            }
        },
        {
            "mark": {
                "type": "point", 
                "filled": true,
                "size": 150,
                "opacity": 1
            },
            "encoding": {
                "x": {
                    "field": "percentage_202122",
                    "type": "quantitative"
                },
                "color": {
                    "datum": "2021-22",
                    "type": "nominal",
                    "scale": {
                        "domain": ["2017-18", "2021-22"],
                        "range": ["#143d51", "#691c2d"]
                    },
                    "legend": { "title": null }
                },
                "tooltip": [
                    { "field": "row_name", "type": "nominal", "title": "Group" },
                    { "field": "percentage_201718", "type": "quantitative", "title": "2017-18 (%)", "format": ".1f" },
                    { "field": "percentage_202122", "type": "quantitative", "title": "2021-22 (%)", "format": ".1f" },
                    { "field": "change_label", "type": "nominal", "title": "Percentage change"}
                ]
            }
        }
    ],

    "config": {
        "view": { "stroke": null }
    }
}