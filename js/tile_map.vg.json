{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 440,
    "height": 440,
    "title": "Attendance rate in each state, 2017-18 to 2021-22",
    "data": {
        "url": "data/attendance_by_state_wide.csv"
    },
    "transform": [
        {
            "calculate": "datum.percentage_201718 - datum.percentage_202122",
            "as": "fall"
        },
        {
            "calculate": "format(datum.percentage_201718, '.1f') + '% to ' + format(datum.percentage_202122, '.1f') + '%'",
            "as": "rates"
        },
        {
            "lookup": "state",
            "from": {
                "data": {
                    "url": "data/tile_grid.csv"
                },
                "key": "state",
                "fields": [
                    "abbr",
                    "col",
                    "row"
                ]
            }
        }
    ],
    "encoding": {
        "x": {
            "field": "col",
            "type": "ordinal",
            "axis": null
        },
        "y": {
            "field": "row",
            "type": "ordinal",
            "axis": null
        }
    },
    "layer": [
        {
            "mark": {
                "type": "rect",
                "stroke": "white",
                "strokeWidth": 3
            },
            "encoding": {
                "color": {
                    "field": "fall",
                    "type": "quantitative",
                    "scale": {
                        "domain": [0, 10, 20, 30],
                        "range": ["#ead3a5", "#e59f45", "#97312d", "#691c2d"]
                    },
                    "legend": {
                        "title": null,
                        "values": [
                            0,
                            30
                        ],
                        "labelExpr": "datum.value == 0 ? 'Smaller fall' : 'Bigger fall'"
                    }
                },
                "tooltip": [
                    {
                        "field": "state",
                        "type": "nominal",
                        "title": "State"
                    },
                    {
                        "field": "percentage_201718",
                        "type": "quantitative",
                        "title": "2017-18 (%)"
                    },
                    {
                        "field": "percentage_202122",
                        "type": "quantitative",
                        "title": "2021-22 (%)"
                    }
                ]
            }
        },
        {
            "mark": {
                "type": "text",
                "fontWeight": "bold",
                "fontSize": 16,
                "dy": -12
            },
            "encoding": {
                "text": {
                    "field": "abbr",
                    "type": "nominal"
                },
                "color": {
                    "condition": {
                        "test": "datum.fall > 14",
                        "value": "white"
                    },
                    "value": "black"
                }
            }
        },
        {
            "mark": {
                "type": "text",
                "fontSize": 12,
                "dy": 10
            },
            "encoding": {
                "text": {
                    "field": "rates",
                    "type": "nominal"
                },
                "color": {
                    "condition": {
                        "test": "datum.fall > 14",
                        "value": "white"
                    },
                    "value": "black"
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": null
        }
    }
}