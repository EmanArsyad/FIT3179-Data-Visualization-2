{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    
    "data": {
        "url": "data/attendance_by_artform.csv"
    },

    "transform": [
        {
            "filter": "datum.sex == 'Persons'"
        },
        {
            "calculate": "round(datum.percentage)",
            "as": "filled"
        },
        {
            "calculate": "indexof(['Live music', 'Theatre', 'Musicals or operas', 'Dance', 'Other performing arts'], datum.art)",
            "as": "order"
        },
        {
            "calculate": "datum.art + '|' + datum.filled + ' in every 100'",
            "as": "heading"
        },
        {
            "calculate": "sequence(0, 100)",
            "as": "square"
        },
        {
            "flatten": ["square"]
        },
        {
            "calculate": "datum.square % 10",
            "as": "col"
        },
        {
            "calculate": "floor(datum.square / 10)",
            "as": "row"
        },
        {
            "calculate": "datum.square < datum.filled ? datum.art : 'Empty'",
            "as": "fill_type"
        }
    ],

    "facet": {
        "field": "heading",
        "type": "nominal",
        "sort": {
            "field": "order",
            "op": "min"
        },
        "header": {
            "title": null,
            "labelExpr": "split(datum.value, '|')",
            "labelFontSize": 14,
            "labelPadding": 8
        }
    },
    "columns": 3,

    "spec": {
        "width": 205,
        "height": 205,
        "mark": "rect",
        "encoding": {
            "x": {
                "field": "col",
                "type": "ordinal",
                "axis": null,
                "scale": {
                    "paddingInner": 0.15
                }
            },
            "y": {
                "field": "row",
                "type": "ordinal",
                "axis": null,
                "sort": "descending",
                "scale": {
                    "paddingInner": 0.15
                }
            },
            "color": {
                "field": "fill_type",
                "type": "nominal",
                "legend": null,
                "scale": {
                    "domain": ["Live music", "Theatre", "Musicals or operas", "Dance", "Other performing arts", "Empty"],
                    "range": ["#691c2d", "#e59f45", "#143d51", "#18615b", "#8c8a86", "#d9d3c7"]
                }
            },
            "tooltip": [
                {
                    "field": "art", "type": "nominal", "title": "Art form"
                },
                {
                    "field": "percentage", "type": "quantitative", "title": "Adults who went (%)"
                }
            ]
        }
    },

    "config": { "view": { "stroke": null } }
}