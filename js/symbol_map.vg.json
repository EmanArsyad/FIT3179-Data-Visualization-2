{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "People attending a live performance, 2021-22",
    "width": "container",
    "height": 450,
    "projection": {
        "type": "conicEqualArea",
        "parallels": [-18, -36],
        "rotate": [-132, 0, 0]
    },
    "layer": [
        {
            "data": {
                "url": "data/australian_states.topojson",
                "format": {
                    "type": "topojson",
                    "feature": "ne_50m_admin_1_states_provinces"
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "#d9d3c7",
                "stroke": "white"
            }
        },
        {
            "data": { "url": "data/attendance_by_city.csv" },
            "mark": {
                "type": "circle",
                "opacity": 0.8,
                "color": "#691c2d"
            },
            "encoding": {
                "longitude": {"field": "longitude", "type": "quantitative"},
                "latitude": {"field": "latitude", "type": "quantitative"},
                "size": {
                    "field": "attendees",
                    "type": "quantitative",
                    "title": "Attendees ('000)",
                    "scale": {
                        "domain": [0, 1800],
                        "range": [0, 2500]
                    }
                },
                "order": {
                    "field": "attendees",
                    "type": "quantitative",
                    "sort": "descending"
                },
                "tooltip": [
                    { "field": "city", "type": "nominal", "title": "City"},
                    { "field": "state", "type": "nominal", "title": "State"},
                    { "field": "attendees", "type": "quantitative", "title": "Attendees ('000)", "format": ",.0f"},
                    { "field": "percentage", "type": "quantitative", "title": "% of adults", "format": ".1f"}
                ]
            }
        }
    ]
}