{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Attendance by state, 2021-22",
    "width": "container",
    "height": 450,
    "projection": {
        "type": "conicEqualArea",
        "parallels": [-18, -36],
        "rotate": [-132, 0, 0]
    },
    "data": {
        "url": "data/australian_states.topojson",
        "format": {"type": "topojson", "feature": "ne_50m_admin_1_states_provinces"}
    },
    "transform": [
        {
            "lookup": "properties.name",
            "from": {
                "data": { "url": "data/attendance_by_state.csv"},
                "key": "state",
                "fields": ["percentage"]
            }
        }
    ],
    
    "mark": {
        "type": "geoshape",
        "stroke": "white"
    },
    "encoding": {
        "color": {
            "field": "percentage",
            "type": "quantitative",
            "title": "% of adults",
            "scale": {
                "type": "threshold",
                "domain": [28, 32, 36],
                "range": ["#ead3a5", "#e59f45", "#97312d", "#691c2d"]
            }
        },
        "tooltip": [
            {"field": "properties.name", "type": "nominal", "title": "State"},
            {"field": "percentage", "type": "quantitative", "title": "% who attended"}
        ]
    }
}